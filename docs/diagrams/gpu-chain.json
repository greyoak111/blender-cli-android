  "cards": [
    {
      "dot": "rose",
      "title": "最难的一道坎",
      "items": [
        "libglvnd 找不到 EGL 厂商驱动时只报 EGL_BAD_PARAMETER",
        "该报错字面像参数错误，实为资源缺失",
        "解法：__EGL_VENDOR_LIBRARY_FILENAMES"
      ]
    },
    {
      "dot": "cyan",
      "title": "四个条件",
      "items": [
        "EGL_PLATFORM=surfaceless（无 /dev/dri）",
        "GALLIUM_DRIVER=zink（GL 转译）",
        "VK_ICD_FILENAMES=补丁版 Turnip",
        "MESA_SHADER_CACHE_DIR=持久目录"
      ]
    },
    {
      "dot": "emerald",
      "title": "实测性能",
      "items": [
        "立方体 640×480：33.51s → 1.75s（19×）",
        "猴头 640×480：35.05s → 7.01s（5.0×）",
        "加速比随场景变化，跨场景比较无意义"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么必须转译",
      "items": [
        "安卓只有 GLES 3.2，没有桌面 GL 4.3+",
        "Freedreno 原生 GL 驱动需要 /dev/dri，本机不存在",
        "所以只能走 Vulkan + Zink 转译"
      ]
    }
  ]
}
